{
  "name": "@dougen/dsh-cdp",
  "version": "0.5.0",
  "description": "Drive an already-running Chromium browser from DSH over CDP — Chrome, Edge, Brave, Vivaldi, Opera, Chromium, Arc, Thorium: one approval per connection, no new tools, no runtime dependencies.",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "scripts": {
    "test": "node --test"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cdp",
    "browser",
    "chromium",
    "chrome",
    "edge",
    "devtools"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dougen/dsh-cdp.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
